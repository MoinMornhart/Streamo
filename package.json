{
  "name": "streamo",
  "version": "1.3.2",
  "description": "Self-hosted series tracker that links all your streaming subscriptions and always tells you where you can watch.",
  "type": "module",
  "license": "MIT",
  "author": "MoinMornhart",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoinMornhart/Streamo.git"
  },
  "homepage": "https://github.com/MoinMornhart/Streamo#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/store.test.mjs",
    "test:update": "bash tests/update.test.sh",
    "test:migration": "node tests/migration.test.mjs",
    "test:template": "bash tests/template-choice.test.sh",
    "test:arch": "bash tests/install-arch.test.sh",
    "test:achievements": "node tests/achievements.test.mjs",
    "test:collections": "node tests/collections.test.mjs",
    "test:friends": "node tests/friends.test.mjs",
    "test:invites": "node tests/invites.test.mjs",
    "test:fuzzy": "node tests/fuzzy.test.mjs",
    "test:recommend": "node tests/recommend.test.mjs",
    "test:totp": "node tests/totp.test.mjs",
    "test:until": "node tests/until.test.mjs",
    "test:calendar": "node tests/calendar.test.mjs",
    "test:watchplan": "node tests/watchplan.test.mjs",
    "test:all": "npm test && npm run test:migration && npm run test:achievements && npm run test:collections && npm run test:friends && npm run test:invites && npm run test:fuzzy && npm run test:recommend && npm run test:totp && npm run test:until && npm run test:calendar && npm run test:watchplan && npm run test:template && npm run test:arch && npm run test:update"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "express": "^5.1.0"
  },
  "keywords": [
    "streaming",
    "series",
    "tv-shows",
    "watchlist",
    "tracker",
    "self-hosted",
    "tmdb",
    "justwatch",
    "proxmox"
  ]
}
