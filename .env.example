# ---------------------------------------------------------------------------
# Streamo configuration
# Copy this file to ".env" and adjust. Every value has a sane default,
# so an empty .env works fine for a first start.
# ---------------------------------------------------------------------------

# Port the web UI + API listen on
PORT=3000

# Interface to bind to. 0.0.0.0 = reachable from your LAN.
HOST=0.0.0.0

# Where the SQLite database lives. Relative paths are resolved from the
# project root. The directory is created automatically.
DATA_DIR=./data

# Secret used to sign session cookies. Leave empty and Streamo generates one
# on first start and stores it in DATA_DIR/secret.key.
SESSION_SECRET=

# TMDB API read access token or v3 API key.
# Get a free one at https://www.themoviedb.org/settings/api
# You can also paste it later in the Streamo setup wizard / settings page.
TMDB_API_KEY=

# Default watch region (ISO 3166-1 alpha-2). Decides which streaming
# providers and availability data are shown. Changeable in the UI.
STREAMO_REGION=DE

# Default UI language for TMDB metadata (ISO 639-1)
STREAMO_LANGUAGE=de-DE

# How often (in hours) availability + metadata are refreshed in the background.
# 0 disables the background sync.
SYNC_INTERVAL_HOURS=12

# Allow new users to register themselves. After the first admin exists this
# is off by default - flip to "true" if you want a family instance.
ALLOW_REGISTRATION=false

# Set to "true" when Streamo sits behind a reverse proxy that terminates TLS.
# Makes session cookies "secure" and trusts X-Forwarded-* headers.
TRUST_PROXY=false
